[Unit]
Description=Omarchy multi-account calendar service
After=graphical-session-pre.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/omarchy-calendar daemon
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Filesystem namespace hardening is intentionally omitted. A separate mount
# namespace makes Linux deny the read-only /proc/<pid>/{exe,fd} checks used to
# authenticate Brave's singleton socket. The user service has no elevated
# privileges and retains the restrictions above.

[Install]
WantedBy=graphical-session.target
