#!/usr/bin/env bash
set -euo pipefail

calendar_bin_path="${HOME}/.local/bin/omarchy-calendar"
calendar_unit_path="${XDG_CONFIG_HOME:-${HOME}/.config}/systemd/user/omarchy-calendar.service"
calendar_skill_dir="${CODEX_HOME:-${HOME}/.codex}/skills/omarchy-calendar"

systemctl --user disable --now omarchy-calendar.service >/dev/null 2>&1 || true
rm -f -- "${calendar_bin_path}" "${calendar_unit_path}"
rm -f -- "${calendar_skill_dir}/SKILL.md"
# Remove only our file and an empty directory, preserving user-added files.
if [[ -d "${calendar_skill_dir}" ]]; then
  rmdir --ignore-fail-on-non-empty -- "${calendar_skill_dir}"
fi
systemctl --user daemon-reload

echo "Omarchy calendar backend and agent skill removed. Account secrets and cached data were retained."
